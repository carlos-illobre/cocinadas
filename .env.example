# Plantilla de configuración. Copiar a .env y completar. El .env real no se versiona.
#
# Regla (ADR-001): todo lo que cambia entre ambientes está acá y en ningún otro lado.
# tests/integration/paridad-env.sh comprueba que .env, .env.example y
# deployment/oracle-single/.env.oracle declaren exactamente las mismas variables.

# ── Qué se levanta ───────────────────────────────────────────────────────────
# Perfiles de compose que se prenden. `proxy` levanta el reverse proxy de la máquina
# (infrastructure/proxy/), que es lo único que ata el 80 y el 443 y termina el TLS.
#
# Se deja VACÍO cuando adelante ya hay otra cosa que hace ese trabajo: un balanceador de
# la nube, o el proxy de otra aplicación que ya tiene esos puertos (ADR-016). En ese caso
# la aplicación sigue atendiendo en PUERTO_APP y no se levanta ningún proxy.
COMPOSE_PROFILES=proxy

# ── La aplicación ────────────────────────────────────────────────────────────
# Dónde queda publicada la app en la máquina. El proxy no la alcanza por acá —la resuelve
# por la red interna del compose—, pero el puerto se publica igual: es lo que deja pegarle
# directo en desarrollo y lo que hace que siga sirviendo con el proxy apagado.
#
# 0.0.0.0 y no 127.0.0.1: en producción lo que lo mantiene fuera de internet es la
# Security List de la VCN, donde este puerto no se abre.
APP_ADDR=0.0.0.0
PUERTO_APP=8180

# ── El proxy ─────────────────────────────────────────────────────────────────
# Dirección del sitio para Caddy: `http://localhost` sin TLS en desarrollo; el dominio a
# secas (cocinadas.duckdns.org) en producción, y Caddy emite el certificado solo.
SITE_ADDRESS=http://localhost

# Adentro del contenedor los puertos no cambian nunca; esto es solo dónde quedan
# publicados en la máquina. Están acá para poder convivir con otra aplicación que ya use
# el 80 o el 443.
#
# PROXY_ADDR: 0.0.0.0 si este proxy es el que atiende de afuera; 127.0.0.1 si otro proxy
# de la misma máquina le pasa el tráfico.
PROXY_ADDR=0.0.0.0
PUERTO_HTTP=80
PUERTO_HTTPS=443

# ── Imágenes ─────────────────────────────────────────────────────────────────
# Prefijo del registro. `local` construye acá; ghcr.io/<usuario> trae del CI.
REGISTRO=local
# Etiqueta de las imágenes: `local` en desarrollo; el SHA del commit en producción
# (lo fija deployment/oracle-single/deploy.py).
TAG=local

# ── Registro de logs ─────────────────────────────────────────────────────────
# Nivel del log de Caddy: DEBUG | INFO | WARN | ERROR.
LOG_LEVEL=INFO

# ── Techos por contenedor ────────────────────────────────────────────────────
# Log: el techo por contenedor es LOG_MAX_SIZE × LOG_MAX_FILES. Con 512k y 2, 1 MB.
# Sin esto el log crece sin límite y llena el disco de la máquina.
LOG_MAX_SIZE=512k
LOG_MAX_FILES=2
# CPU: techo por contenedor, no reserva. La suma puede pasar los núcleos de la máquina.
CPU_LIMIT_APP=0.5
CPU_LIMIT_PROXY=0.5

# ── Techos de memoria (docker mem_limit) ─────────────────────────────────────
# La suma tiene que entrar en la memoria DISPONIBLE de la máquina (preflight.sh la mide).
MEM_LIMIT_APP=128m
MEM_LIMIT_PROXY=128m
