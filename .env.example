# Plantilla de configuración. Copiar a .env y completar. El .env real no se versiona.
#
# Regla (ADR-001): todo lo que cambia entre ambientes está acá y en ningún otro lado.
# tests/integration/paridad-env.sh comprueba que .env, .env.example y
# deployment/oracle-single/.env.oracle declaren exactamente las mismas variables.

# ── Publicación ──────────────────────────────────────────────────────────────
# Interfaz en la que se publican los puertos de los servicios internos.
# 0.0.0.0 en desarrollo para llegar desde el navegador; 127.0.0.1 en producción.
PUBLISH_ADDR=0.0.0.0
# Dirección del sitio para Caddy: `http://localhost` sin TLS en desarrollo; el dominio a
# secas (templa.duckdns.org) en producción, y Caddy emite el certificado solo.
SITE_ADDRESS=http://localhost

# ── Imágenes ─────────────────────────────────────────────────────────────────
# Prefijo del registro. `local` construye acá; ghcr.io/<usuario> trae del CI.
REGISTRO=local
# Etiqueta de las imágenes: `local` en desarrollo; el SHA del commit en producción
# (lo fija deployment/oracle-single/deploy.sh).
TAG=local

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER=templa
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=templa

# ── Seguridad ────────────────────────────────────────────────────────────────
# Clave con la que usuarios firma los JWT y los demás servicios los verifican (ADR-012).
# Generar una con: openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto

# ── Registro de logs ─────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Techos de memoria (docker mem_limit) ─────────────────────────────────────
# La suma tiene que entrar en la memoria DISPONIBLE de la máquina (preflight.sh la mide).
MEM_LIMIT_NODE=256m
MEM_LIMIT_POSTGRES=512m
MEM_LIMIT_NATS=256m
MEM_LIMIT_PROXY=128m
