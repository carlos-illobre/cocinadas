# Reverse proxy del sistema (ADR-009). Un solo sitio: la SPA en la raíz y cada
# microservicio bajo /api/<servicio>/.
#
# SITE_ADDRESS sale del .env: `http://localhost` en desarrollo (sin TLS, sin redirección),
# el dominio a secas en producción, con lo que Caddy pide el certificado a Let's Encrypt
# por HTTP-01 (el puerto 80 tiene que estar abierto en la Security List) y lo renueva
# solo, recargando sin reiniciar. Es el punto que con nginx+certbot hay que orquestar a
# mano y que se olvida.

{
	# La API de administración deja reconfigurar el proxy entero por HTTP. Vive en la red
	# del compose, así que cualquier contenedor comprometido podría usarla. No hace falta:
	# la configuración cambia recreando el contenedor.
	admin off
}

# Sitio interno para el healthcheck del compose y del despliegue. No se publica ningún
# puerto hacia acá: solo se llega desde adentro del contenedor.
:8081 {
	respond /salud 200
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cabeceras de seguridad, para todo lo que sale de acá.
	header {
		# Un año de HTTPS obligatorio. Sobre http:// el navegador la ignora, así que en
		# desarrollo no molesta.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Sin adivinar el tipo: una foto servida como imagen no se ejecuta como script.
		X-Content-Type-Options "nosniff"
		# Al salir del sitio se manda el origen, nunca la ruta completa.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nada de cámara, micrófono ni ubicación: la app no los usa.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# De dónde puede cargar cada cosa. Las tipografías vienen de Google Fonts; el resto
		# es propio. `unsafe-inline` en los estilos es por los `style` que pone React para
		# las barras y el gantt; los scripts no lo tienen.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# El servidor no anuncia qué es.
		-Server
	}

	# handle_path quita el prefijo antes de reenviar: /api/catalogo/health llega al
	# servicio como /health. Así los servicios no saben bajo qué ruta se los publica y la
	# misma imagen sirve para cualquier despliegue.
	handle_path /api/catalogo/* {
		reverse_proxy catalogo:3001
	}
	handle_path /api/usuarios/* {
		reverse_proxy usuarios:3002
	}
	handle_path /api/cocinadas/* {
		reverse_proxy cocinadas:3003
	}

	# Todo lo demás es la SPA. El frontend resuelve las rutas del navegador por su cuenta.
	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format console
	}
}
