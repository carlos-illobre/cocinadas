# Plantilla del .env de la APLICACIÓN para la instancia de Oracle. Se copia una vez a
# /home/<usuario>/templa/.env en la VM y se completa a mano; nunca se versiona con
# valores reales. deploy.sh no la pisa: solo actualiza TAG.
#
# Mismas variables que .env.example (lo verifica tests/integration/paridad-env.sh).

# ── Publicación ──────────────────────────────────────────────────────────────
# En producción los servicios internos escuchan solo en la interfaz local: aunque alguien
# abra un puerto de más en la Security List, del otro lado no hay nada.
PUBLISH_ADDR=127.0.0.1
# El dominio a secas hace que Caddy pida el certificado a Let's Encrypt, y para eso
# necesita el 80 y el 443 de la máquina. Si otra aplicación ya los tiene, poner
# `http://templa.duckdns.org` y dejar que ese proxy termine el TLS: ver «Convivir con
# otra aplicación» en el README de esta carpeta.
SITE_ADDRESS=templa.duckdns.org

# ── Puertos del host ─────────────────────────────────────────────────────────
# Los valores de abajo son los de una máquina donde Templa es la única aplicación.
# Conviviendo con otra que ya usa el 80, el 443 y el 8080, cambiar a:
#
#   PROXY_ADDR=127.0.0.1
#   PUERTO_HTTP=8280
#   PUERTO_HTTPS=8243
#   PUERTO_FRONTEND=8180
#
# y ajustar SITE_ADDRESS como dice el comentario de arriba. Los tres servicios ya están
# en 31xx, que no choca con nada habitual, pero también se pueden mover.
PROXY_ADDR=0.0.0.0
PUERTO_HTTP=80
PUERTO_HTTPS=443
PUERTO_FRONTEND=8180
PUERTO_CATALOGO=3101
PUERTO_USUARIOS=3102
PUERTO_COCINADAS=3103

# ── Imágenes ─────────────────────────────────────────────────────────────────
REGISTRO=ghcr.io/<USUARIO_GITHUB>
# TAG lo fija deploy.sh con el SHA del commit; el valor de acá es solo para el primer
# arranque a mano.
TAG=<SHA_DEL_COMMIT>

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER=templa
POSTGRES_PASSWORD=<CONTRASENA_LARGA_ALEATORIA>
POSTGRES_DB=templa

# ── Seguridad ────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=<SECRETO_LARGO_ALEATORIO>

# ── Registro de logs ─────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Techos por contenedor ────────────────────────────────────────────────────
# Log: el techo por contenedor es LOG_MAX_SIZE × LOG_MAX_FILES. Con 512k y 2, 1 MB.
# Sin esto el log crece sin límite y llena el disco de la máquina.
LOG_MAX_SIZE=512k
LOG_MAX_FILES=2
# CPU: techo por contenedor, no reserva. La suma puede pasar los núcleos de la máquina.
CPU_LIMIT_NODE=0.5
CPU_LIMIT_POSTGRES=1.0
CPU_LIMIT_NATS=0.25
CPU_LIMIT_PROXY=0.5
# Peticiones por minuto y por IP que acepta cada servicio antes de contestar 429.
RATE_LIMIT_POR_MINUTO=120

# ── Techos de memoria (docker mem_limit) ─────────────────────────────────────
# Suma: 3 × 256m + 512m + 256m + 2 × 128m = 1792m. Entra en una Ampere A1; en una
# Micro AMD de 1 GB hay que bajarlos.
MEM_LIMIT_NODE=256m
MEM_LIMIT_POSTGRES=512m
MEM_LIMIT_NATS=256m
MEM_LIMIT_PROXY=128m
