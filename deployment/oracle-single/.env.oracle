# Plantilla del .env de la APLICACIÓN para la instancia de Oracle. Se copia una vez a
# /home/<usuario>/cocinadas/.env en la VM y se completa a mano; nunca se versiona con
# valores reales. deploy.py no la pisa: solo actualiza TAG.
#
# Mismas variables que .env.example (lo verifica tests/integration/paridad-env.sh).
# Ninguna es un secreto: no hay base de datos ni tokens que firmar (ADR-015).

# ── Qué se levanta ───────────────────────────────────────────────────────────
# `proxy` cuando Cocinadas es la que tiene el 80 y el 443 de la VM. Si ya los tiene otra
# aplicación, se deja VACÍO y esa otra le pasa el tráfico a PUERTO_APP (ver «Convivir con
# otra aplicación» en el README de esta carpeta).
COMPOSE_PROFILES=proxy

# ── La aplicación ────────────────────────────────────────────────────────────
# En 0.0.0.0 para que el proxy de la máquina —el de acá o el de otra aplicación— pueda
# alcanzarla desde su contenedor. Este puerto NO se abre en la Security List de la VCN,
# que es lo que la mantiene fuera de internet.
APP_ADDR=0.0.0.0
PUERTO_APP=8180

# ── El proxy ─────────────────────────────────────────────────────────────────
# El dominio a secas hace que Caddy pida el certificado a Let's Encrypt, y para eso
# necesita el 80 y el 443 de la máquina.
SITE_ADDRESS=cocinadas.duckdns.org

# Los valores de abajo son los de una máquina donde este proxy es el que atiende de
# afuera. Si el 80 y el 443 los tiene otra aplicación, poner COMPOSE_PROFILES vacío: no
# hace falta tocar nada más acá, porque el proxy directamente no se levanta.
PROXY_ADDR=0.0.0.0
PUERTO_HTTP=80
PUERTO_HTTPS=443

# ── Imágenes ─────────────────────────────────────────────────────────────────
REGISTRO=ghcr.io/<USUARIO_GITHUB>
# TAG lo fija deploy.py con el SHA del commit; el valor de acá es solo para el primer
# arranque a mano.
TAG=<SHA_DEL_COMMIT>

# ── Registro de logs ─────────────────────────────────────────────────────────
# Nivel del log de Caddy: DEBUG | INFO | WARN | ERROR.
LOG_LEVEL=INFO

# ── Techos por contenedor ────────────────────────────────────────────────────
# Log: el techo por contenedor es LOG_MAX_SIZE × LOG_MAX_FILES. Con 512k y 2, 1 MB.
LOG_MAX_SIZE=512k
LOG_MAX_FILES=2
CPU_LIMIT_APP=0.5
CPU_LIMIT_PROXY=0.5

# ── Techos de memoria (docker mem_limit) ─────────────────────────────────────
# Suma: 128m (la app) + 128m (el proxy) = 256m. Con el proxy apagado, 128m.
MEM_LIMIT_APP=128m
MEM_LIMIT_PROXY=128m
