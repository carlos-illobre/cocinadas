{
  "name": "cocinadas-web",
  "version": "0.1.0",
  "description": "Cocinadas: la app entera, React + TypeScript, compilada con Vite y publicada en GitHub Pages.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm generar:catalogo && vite",
    "generar:catalogo": "tsx herramientas/catalogo/generar.ts",
    "optimizar": "tsx herramientas/imagenes/optimizar.ts",
    "build": "pnpm generar:catalogo && tsc -p tsconfig.build.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "tsc -p tsconfig.json --noEmit && eslint ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
