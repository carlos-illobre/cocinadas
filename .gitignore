# Configuración real: nunca al repositorio (ver docs/SECURITY.md)
.env
deployment/*/.env

# Dependencias y artefactos de build de cada servicio
node_modules/
dist/
# Generado en cada build a partir de web/assets/ (ADR-015): la fuente son los originales
# de data/ y docs/mockups/, y las versiones chicas versionadas de web/assets/.
web/public/api/
web/public/inicio/
coverage/
reports/
# Salida de Playwright: trazas, capturas y el informe HTML de la última corrida
web/test-results/
web/playwright-report/
.stryker-tmp/
*.tsbuildinfo

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Temporales de la sesión de Claude
.claude/settings.local.json
# Carpeta de trabajo descartable: nada de acá se versiona ni sobrevive a la tarea
tmp/

# Bytecode de Python (deploy.py se compila al verificarlo)
__pycache__/
*.pyc
